@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

:root {
  --bg: #0b1020;
  --panel: rgba(15, 23, 42, 0.86);
  --panel-alt: rgba(17, 24, 39, 0.96);
  --sidebar: rgba(11, 16, 32, 0.92);
  --card: rgba(148, 163, 184, 0.08);
  --text: #e5eefc;
  --muted: #a7b3c9;
  --line: rgba(148, 163, 184, 0.18);
  --primary: #7dd3fc;
  --primary-strong: #38bdf8;
  --assistant: rgba(59, 130, 246, 0.18);
  --user: rgba(168, 85, 247, 0.22);
  --shadow: 0 20px 45px rgba(15, 23, 42, 0.45);
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  height: 100%;
  font-family: 'Inter', sans-serif;
  background: radial-gradient(circle at top, rgba(125, 211, 252, 0.18), transparent 25%), var(--bg);
  color: var(--text);
}

body {
  min-height: 100vh;
}

button, textarea {
  font: inherit;
}

.app-shell {
  display: flex;
  height: 100vh;
  width: 100%;
  max-width: 1650px;
  margin: 0 auto;
  padding: 24px;
  gap: 20px;
}

.sidebar {
  width: 310px;
  background: var(--sidebar);
  border: 1px solid var(--line);
  border-radius: 28px;
  box-shadow: var(--shadow);
  padding: 24px 18px;
  display: flex;
  flex-direction: column;
}

.brand-wrap {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 28px;
}

.brand-mark {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--primary), var(--primary-strong));
  color: #02111d;
  font-weight: 800;
  font-size: 1.3rem;
}

.eyebrow {
  margin: 0 0 4px 0;
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--muted);
}

h1, h2, p {
  margin: 0;
}

h1 {
  font-size: 1.8rem;
}

.sidebar-nav {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-bottom: 22px;
}

.nav-button,
.prompt-chip {
  border: 1px solid var(--line);
  background: transparent;
  color: var(--text);
  border-radius: 14px;
  padding: 12px 14px;
  text-align: left;
  cursor: pointer;
  transition: 0.2s ease;
}

.nav-button:hover,
.prompt-chip:hover {
  border-color: rgba(125, 211, 252, 0.45);
  transform: translateY(-1px);
}

.nav-button.active {
  background: rgba(125, 211, 252, 0.12);
  border-color: rgba(125, 211, 252, 0.3);
}

.quick-prompts {
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin-top: 8px;
}

.section-label {
  color: var(--muted);
  margin-bottom: 4px;
  font-size: 0.8rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.prompt-chip {
  background: rgba(148, 163, 184, 0.04);
  color: var(--muted);
}

.chat-panel {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: rgba(15, 23, 42, 0.68);
  border: 1px solid var(--line);
  border-radius: 28px;
  overflow: hidden;
  box-shadow: var(--shadow);
}

.chat-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20px 24px;
  background: rgba(15, 23, 42, 0.7);
  border-bottom: 1px solid var(--line);
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 12px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: rgba(34, 197, 94, 0.08);
  color: #bbf7d0;
  font-size: 0.8rem;
}

.status-dot {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #4ade80;
  box-shadow: 0 0 12px rgba(74, 222, 128, 0.8);
}

.messages {
  flex: 1;
  overflow-y: auto;
  padding: 28px 24px 18px;
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.message-row {
  display: flex;
}

.message-row.user {
  justify-content: flex-end;
}

.message-bubble {
  max-width: min(78%, 760px);
  padding: 16px 18px;
  border-radius: 20px;
  line-height: 1.6;
  white-space: pre-wrap;
  border: 1px solid transparent;
}

.message-row.assistant .message-bubble {
  background: var(--assistant);
  border-color: rgba(59, 130, 246, 0.18);
}

.message-row.user .message-bubble {
  background: var(--user);
  border-color: rgba(168, 85, 247, 0.18);
}

.typing-bubble {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-width: 88px;
}

.typing-bubble span {
  width: 8px;
  height: 8px;
  display: block;
  border-radius: 50%;
  background: rgba(226, 232, 240, 0.7);
  animation: bounce 1s infinite ease-in-out;
}

.typing-bubble span:nth-child(2) {
  animation-delay: 0.15s;
}

.typing-bubble span:nth-child(3) {
  animation-delay: 0.3s;
}

@keyframes bounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.5; }
  40% { transform: translateY(-5px); opacity: 1; }
}

.composer {
  display: flex;
  align-items: flex-end;
  gap: 12px;
  padding: 18px 24px 22px;
  border-top: 1px solid var(--line);
  background: rgba(15, 23, 42, 0.7);
}

.composer textarea {
  flex: 1;
  resize: none;
  min-height: 56px;
  max-height: 160px;
  border: 1px solid var(--line);
  background: rgba(15, 23, 42, 0.85);
  color: var(--text);
  border-radius: 18px;
  padding: 16px 18px;
  line-height: 1.5;
  outline: none;
}

.composer textarea:focus {
  border-color: rgba(125, 211, 252, 0.5);
  box-shadow: 0 0 0 3px rgba(125, 211, 252, 0.15);
}

.composer button {
  height: 56px;
  min-width: 120px;
  border: none;
  border-radius: 18px;
  background: linear-gradient(135deg, var(--primary), var(--primary-strong));
  color: #02111d;
  font-weight: 700;
  cursor: pointer;
  box-shadow: 0 12px 24px rgba(56, 189, 248, 0.35);
}

@media (max-width: 900px) {
  .app-shell {
    flex-direction: column;
    padding: 12px;
  }

  .sidebar {
    width: 100%;
  }

  .chat-panel {
    min-height: 65vh;
  }
}
